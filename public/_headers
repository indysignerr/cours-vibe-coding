/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  # Par défaut Cloudflare garde le HTML une semaine en cache edge. Une page
  # supprimée restait alors servie en 200 pendant sept jours. On revalide.
  Cache-Control: public, max-age=0, must-revalidate

# Les fichiers versionnés par le build ne changent jamais sous le même nom.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/starters/*
  Cache-Control: public, max-age=86400

/brand/*
  Cache-Control: public, max-age=86400

/albert-light.ics
  Cache-Control: public, max-age=3600
