# Supabase. Ces deux valeurs sont publiques par nature : elles finissent
# dans le bundle du navigateur. La sécurité repose entièrement sur les
# politiques RLS de supabase/schema.sql, jamais sur le secret de la clé.
#
# La clé attendue est la PUBLISHABLE key, celle qui commence par
# sb_publishable_. Jamais une secret key, jamais une service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
